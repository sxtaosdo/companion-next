async function readExecution(){const item=record.value;if(!item||busy.value)return;busy.value='查询执行状态';error.value='';try{details.value=await props.provider.readExecution(item.id);update(details.value.record)}catch{markStale(item.id);error.value='执行状态未读取成功，不能据此重跑或判定停止。'}finally{busy.value=''}}
function preparationMatches(row:PreparationRead){return !!record.value&&row.evidence.goalDigest===record.value.goal.digest&&(row.evidence.planDigest===null?row.evidence.phase==='plan':row.evidence.planDigest===record.value.plan?.digest)}
async function readPreparation(){const item=record.value;if(!item||busy.value||!props.provider.readPreparation)return;busy.value='读取准备调用证据';preparationError.value='';try{const result=await props.provider.readPreparation(item.id);if(selectedId.value!==item.id)return;preparation.value=result;preparationStale.value=false}catch{preparationStale.value=true;preparationError.value='准备调用证据读取失败；保留上次观察，不视为已采用。'}finally{busy.value=''}}

async function readApprovals(){const item=record.value;if(!item||busy.value||!props.provider.readApprovals)return;busy.value='读取当前会话审批';approvalError.value='';try{const result=await props.provider.readApprovals(item.id);if(selectedId.value!==item.id)return;approvals.value=result;approvalsStale.value=false;approvalClock.value=Date.now()}catch{approvalsStale.value=true;approvalError.value='审批读取失败；连接和能力未确认，不能批准或重发。'}finally{busy.value=''}}
async function decideApproval(item:WorkflowApproval,decision:'accept'|'decline'){
 const workflow=record.value;if(!workflow||!approvalActionable(item)||!props.provider.readApprovals||!props.provider.decideApproval)return
 const workflowId=workflow.id;busy.value='核对原会话待决请求';approvalError.value='';let live:WorkflowApproval|undefined
 try{const result=await props.provider.readApprovals(workflowId);if(selectedId.value!==workflowId)return;approvals.value=result;approvalsStale.value=false;approvalClock.value=Date.now();live=result.approvals.find(a=>a.id===item.id);if(!result.enabled||!live||live.version!==item.version||live.approvalDigest!==item.approvalDigest||live.connectionId!==item.connectionId||live.threadId!==item.threadId||live.turnId!==item.turnId||live.itemId!==item.itemId||live.state!=='pending'||!live.canRespond||Date.parse(live.expiresAt)<=approvalClock.value){approvalError.value='原请求已变化、失效或断线；没有发送决定，请重新核对。';return}}
 catch{approvalsStale.value=true;approvalError.value='未能核对原会话请求；没有发送决定。';return}finally{busy.value=''}
 if(!live)return;approvalsStale.value=true;const operationId=crypto.randomUUID();const target=live
 await command(decision==='accept'?'仅本次批准':'拒绝本次请求',()=>props.provider.decideApproval!(workflowId,{operationId,approvalId:target.id,expectedVersion:target.version,approvalDigest:target.approvalDigest,decision}),operationId)
 if(!activePending.value&&selectedId.value===workflowId)await readApprovals()
}

async function resume(){
 const item=record.value;if(!item||item.state!=='paused'||locked.value||!readinessProofCurrent.value)return
 await readReadiness();if(!readinessProofCurrent.value||selectedId.value!==item.id)return
 busy.value='恢复前核对';error.value='';let latest:WorkflowOperationRecord
 try{const read=await props.provider.readExecution(item.id);details.value=read;latest=read.record;update(latest)}catch{markStale(item.id);error.value='恢复前状态未确认，没有提交恢复。';return}finally{busy.value=''}
 if(latest.state!=='paused'||!activeRun(latest)?.executionId){notice.value='最新状态不允许恢复，没有重发已完成动作。';return}
 const c=envelope(latest);void command('恢复同一执行',()=>props.provider.resume(latest.id,c),c.operationId)
}
watch(()=>[record.value?.id,record.value?.revision],()=>{recoveryPreview.value=null;recoveryPreviewError.value='';})
async function readRecoveryPreflight(){
 const item=record.value;if(!item||busy.value||!props.provider.readRecoveryPreflight)return;
 const revision=item.revision;busy.value='读取恢复条件';recoveryPreview.value=null;recoveryPreviewError.value='';
 try{const result=await props.provider.readRecoveryPreflight(item.id);if(record.value?.id!==item.id||record.value.revision!==revision||result.revision!==revision)throw Error('STALE_PREFLIGHT');recoveryPreview.value=result;}
 catch{recoveryPreviewError.value='恢复条件读取失败或状态已变化；未发送处置，请刷新后重新读取。';}finally{busy.value=''}
}
async function abandonBeforeTurn(){
 const item=record.value,original=item?activeRun(item):undefined;if(!item||item.state!=='unknown'||!original||busy.value||isStale(item)||!recoveryPreview.value?.canRequestVerification||recoveryPreview.value.revision!==item.revision||!props.provider.abandonBeforeTurn)return;
 busy.value='核对未派发证据';error.value='';
 try{update(await props.provider.abandonBeforeTurn(item.id,{operationId:original.operationId,expectedRevision:item.revision}));notice.value='已按服务端证据追加放弃处置；原 UNKNOWN 审计保留。'}
 catch{markStale(item.id);recoveryPreview.value=null;error.value='恢复证据不足或提交结果未确认；保留 UNKNOWN，请读取原目标状态，不自动重试。'}finally{busy.value=''}
}
async function findServerRequest(){const item=record.value;if(!item||busy.value||pending.value||pendingCorrupt.value||!props.provider.listRequestIngress)return;busy.value='查找服务端请求';try{const rows=await props.provider.listRequestIngress(item.id),candidates=[] as typeof rows;for(const row of rows){if(!['plan','review','start','pause','resume','accept'].includes(row.kind)||row.state==='rejected')continue;if(row.state==='settled'){const op=await props.provider.getOperation(row.operationId,item.id);if(op.state==='settled')continue}candidates.push(row)}if(candidates.length===0){const refused=rows.filter(row=>row.state==='rejected');if(refused.length){notice.value='已记录的拒绝：'+refused.slice(-3).map(row=>`${row.operationId}${row.code?`（${row.code}）`:''}`).join('、')+'。';return}}if(candidates.length!==1)throw Error();const row=candidates[0],request={operationId:row.operationId,workflowId:item.id,kind:row.kind};const st=storage();if(!st||st.getItem(pendingKey)!==null)throw Error();savePending(request);if(st.getItem(pendingKey)!==JSON.stringify(request))throw Error();pending.value=request;notice.value='已找回唯一的服务端待核请求；不会自动重发。'}catch{error.value='未能唯一核对服务端请求；没有更改原记录。'}finally{busy.value=''}}
async function reconcile(){if(!pending.value||busy.value)return;const request={...pending.value};busy.value='查询请求结果';error.value='';try{const result=await props.provider.getOperation(request.operationId,request.workflowId);if(result.operationId!==request.operationId||(result.record&&result.record.id!==result.workflowId)||(request.workflowId&&result.workflowId&&request.workflowId!==result.workflowId))throw Error();if(result.record)update(result.record);if(result.state==='settled'&&result.record){pending.value=null;clearPending();notice.value='已读取该请求结果，未重新提交。'}else if(result.state==='not-observed'&&request.workflowId&&props.provider.readRequestIngress){const ingress=await props.provider.readRequestIngress(request.workflowId,request.operationId);const detail=ingress.code&&/^[A-Z][A-Z0-9_]{1,99}$/.test(ingress.code)?`（${ingress.code}）`:'';notice.value=`服务端请求状态 ${ingress.state}${detail}；保持写入锁定，不自动重发。`}else notice.value='该请求结果仍未确认，保持写入锁定，不自动重发。'}catch{error.value='请求结果读取失败，继续保留原操作标识。'}finally{busy.value=''}}
const formalRun=computed(()=>record.value?taskDirectoryRun(record.value):undefined)
const acceptanceScope=computed(()=>formalRun.value?'task-directory':run.value?.capability==='restricted-readonly-model-output'?'technical-sample':'unverified')
function accept(){const item=record.value;if(acceptanceScope.value==='unverified'||!item||item.state!=='completed'||!details.value||!acceptanceNote.value.trim()||!selectedEvidence.value.length||locked.value)return;const c=envelope(item);void command('提交验收',()=>props.provider.accept(item.id,{...c,evidenceDigests:[...selectedEvidence.value],note:acceptanceNote.value.trim()}),c.operationId)}
function select(id:string){resetReadiness();approvals.value=null;approvalsStale.value=false;approvalError.value='';preparation.value=null;preparationStale.value=false;preparationError.value='';selectedId.value=id;details.value=null;acceptanceNote.value='';selectedEvidence.value=[]}
function selectWorkflow(id:string):boolean{if(!visibleRecords.value.some(item=>item.id===id))return false;select(id);return true}
defineExpose({refresh,selectWorkflow})
onMounted(()=>{restorePending();restoreTrackingPending();restoreIndependent();restoreFollowup();restoreContinuation();restoreLost();restoreFinishPending();void refresh();approvalClockTimer=setInterval(()=>{approvalClock.value=Date.now()},1000)})
onBeforeUnmount(()=>{if(approvalClockTimer)clearInterval(approvalClockTimer)})
</script>
