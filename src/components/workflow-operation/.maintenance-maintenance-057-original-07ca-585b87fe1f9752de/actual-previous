dentSelected&&record.state==='completed'&&run?.state==='completed'&&!run.acceptance"><button type="button" :disabled="!!busy||isStale(record)||!!finishPending||finishCorrupt" @click="finishConfirm=true">保留结果并结束追踪（未通过验收）</button><div v-if="finishConfirm"><p>只记录未通过验收，保留原目录和审计；不取消执行，不恢复旧任务。</p><label>输入原执行请求标识<input v-model="finishTyped" autocomplete="off"></label><button type="button" :disabled="!!busy||finishTyped!==run.operationId" @click="finishUnaccepted">确认结束追踪</button><button type="button" :disabled="!!busy" @click="finishConfirm=false">返回</button></div></template><section v-if="finishPending" role="status">处置回执待核对，通道保持锁定。<button type="button" :disabled="!!busy" @click="reconcileFinished">查询收尾回执</button></section><p v-if="finishCorrupt" role="alert">收尾记录不可读，通道保持锁定。</p></section>
