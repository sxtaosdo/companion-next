el><input type="checkbox" data-testid="lost-agreed" v-model="lostAgreed">确认记录未知结果并保留原隔离。</label><button type="button" data-testid="lost-submit" :disabled="!!busy||!lostAgreed||!!lostPending||lostCorrupt" @click="recordLost">记录未知结果屏障</button></div></template><section v-if="lostPending" role="status">屏障待核对，不自动重发。请求编号：{{ lostPending.operationId }}。<button type="button" :disabled="!!busy" @click="queryLost">查询屏障结果</button></section><p v-if="lostCorrupt" role="alert">屏障记录不可读，保持锁定。</p><section v-if="continuationPending" role="status">后续通道待核对，不自动重发。请求编号：{{ continuationPending.operationId }}。<button type="button" :disabled="!!busy" @click="reconcileContinuation">查询后续通道结果</button></section><p v-if="continuationCorrupt" role="alert">后续通道记录不可读，保持锁定。</p></section>
