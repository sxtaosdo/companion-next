  <article v-if="record"><h3>{{ record.presentation?.title||record.id }}</h3><p v-if="record.presentation?.description">{{ record.presentation.description }}</p><el-tag class="companion-status-tag" :type="isStale(record)?'warning':tone(displayedState(record))"><el-icon class="companion-status-icon" :class="{'is-loading':!isStale(record)&&['running','planning'].includes(displayedState(record))}"><Warning v-if="isStale(record)||displayedState(record)==='unknown'"/><Loading v-else-if="['running','planning'].includes(displayedState(record))"/><CircleClose v-else-if="record.state==='failed'"/><CircleCheck v-else-if="record.state==='accepted'"/><InfoFilled v-else/></el-icon>{{ stateLabel(record) }}</el-tag><p class="metadata">GSD · {{ record.goal.ref }} · {{ record.goal.digest }}<br>目标版本 {{ record.goal.version??'来源未提供' }} · 记录 revision {{ record.revision }}</p>
   <section v-if="showSection('specs','tasks')" aria-label="计划与审阅"><h4>计划与审阅</h4><template v-if="record.plan"><p class="metadata">OpenSpec · {{ record.plan.ref }} · {{ record.plan.digest }} · {{ record.plan.version??'来源版本未提供' }}</p><pre v-if="record.presentation?.planText">{{ record.presentation.planText }}</pre><p v-else>计划正文尚未读取，不能据摘要批准。</p></template><p v-else>尚无计划；不会自动启动执行。</p><section v-if="record.plan" aria-label="任务与来源审阅"><h5>任务与来源审阅</h5><p v-if="record.state==='paused'">只可重新核对原已选任务的依赖；不会更换任务、会话或自动恢复。</p><p v-if="record.state==='paused'&&!record.review?.readiness?.selectedTaskId">该历史执行未记录原任务绑定，不能推测新的审阅目标。</p><el-button :disabled="!!busy||!provider.readReadiness" @click="readReadiness">读取审阅目录</el-button><p v-if="!provider.readReadiness">审阅目录未接通，来源就绪未验证，不能启动。</p><p v-if="readinessError" role="status">{{ readinessError }}</p><p v-if="readinessNotice" role="status">{{ readinessNotice }}</p><p v-if="readinessStale">上次审阅目录观察 · 当前待核对</p><p v-if="!readiness">尚未读取真实任务与来源；不能用计划勾选代替就绪证据。</p><template v-else><p v-if="!readinessBound" role="status">目标或计划版本已变化，请先读取最新状态后重新核对。</p><p v-if="readiness.availability==='unconfigured'" role="status">来源政策未配置，不能审阅或启动。</p><p v-if="readiness.currentStatus==='stale'" role="status">已保存的审阅来源已变化或过期，不能继续使用。</p><label for="workflow-review-task">选择计划中的真实任务</label><select id="workflow-review-task" :value="selectedTaskId" :disabled="recordLocked||!readinessBound||readinessStale||!['review','paused'].includes(record.state)" @change="chooseReadinessTask(($event.target as HTMLSelectElement).value)"><option value="">选择任务</option><option v-for="task in readiness.tasks" :key="task.id" :value="task.id" :disabled="record.state==='paused'&&task.id!==record.review?.readiness?.selectedTaskId">{{ task.id }} · {{ task.text }}</option></select><template v-if="selectedTask"><p>{{ selectedTask.text }}</p><small>任务摘要 {{ selectedTask.digest }} · tasks.md 摘要 {{ selectedTask.artifactDigest }}</small><p v-if="selectedTask.requiredDependencies===null">该任务依赖未配置，不能审阅。</p><p v-else>必需依赖：{{ selectedTask.requiredDependencies.join('、') }}</p><fieldset><legend>选择后端核验的来源</legend><label v-for="source in readiness.sources.filter(s=>s.taskId===null||s.taskId===selectedTaskId)" :key="source.id" class="evidence-row"><input type="checkbox" :checked="selectedSourceIds.includes(source.id)" :disabled="recordLocked||readinessStale||!readinessBound||!sourceSelectable(source)||!['review','paused'].includes(record.state)" @change="chooseReadinessSource(source,($event.target as HTMLInputElement).checked)"><span>{{ source.label }} · {{ source.status==='verified'?'后端已核验':'受阻' }}<small>{{ source.id }} · {{ source.digest }}</small><small>有效期 {{ source.expiresAt??'未确认' }}<span v-if="source.expiresAt&&Date.parse(source.expiresAt)<=approvalClock"> · 已过期</span></small><small>解决：{{ source.resolves.join('、')||'无' }} · 剩余：{{ source.remaining.join('、')||'无' }}</small><small v-if="source.reason">原因：{{ source.reason }}</small></span></label></fieldset><p v-if="unresolvedDependencies.length">尚缺依赖：{{ unresolvedDependencies.join('、') }}</p><label for="workflow-review-note">审阅备注</label><textarea id="workflow-review-note" v-model="reviewNote" maxlength="2000" :disabled="recordLocked||!['review','paused'].includes(record.state)"/><p>身份由后端认证；此处不接收项目 Owner 声明、路径或就绪勾选。</p></template><details v-if="readiness.current"><summary>已保存的不可变审阅记录</summary><dl><dt>记录</dt><dd>{{ readiness.current.id }} · v{{ readiness.current.version }}</dd><dt>来源</dt><dd>{{ readiness.current.ref }}</dd><dt>摘要</dt><dd>{{ readiness.current.digest }}</dd><dt>任务</dt><dd>{{ readiness.current.selectedTaskId }}</dd><dt>有效期</dt><dd>{{ readiness.current.expiresAt }}<span v-if="Date.parse(readiness.current.expiresAt)<=approvalClock"> · 已过期</span></dd><dt>状态</dt><dd>{{ readiness.currentStatus==='fresh'?'后端当前核验有效':readiness.currentStatus==='stale'?'来源变化 / 已失效':'未核验' }}</dd><dt>审阅身份</dt><dd>{{ readiness.current.actor.kind==='isolated-control-harness'?'隔离控制样例（非浏览器登录）':'后端认证主体，不等于项目 Owner 声明' }}</dd></dl></details></template></section><div class="commands"><el-button v-if="['draft','review','ready'].includes(record.state)" :disabled="recordLocked" @click="plan">生成计划</el-button><el-button v-if="['review','paused'].includes(record.state)" :disabled="!canReview||!record.plan||!record.presentation?.planText" @click="review">{{ record.state==='paused'?'重新审阅原任务依赖':'审阅并批准此版本计划' }}</el-button><el-button v-if="record.state==='ready'" type="primary" :disabled="recordLocked||!canStart(record)||!readinessProofCurrent" @click="start">启动执行</el-button></div></section>
   <section v-if="showSection('execution','evidence')" aria-label="执行与回执"><h4>执行与回执</h4><p v-if="run">执行标识：{{ run.executionId??'尚未确认' }} · {{ run.lastObservedAt }}</p><p v-if="run?.reason">{{ run.reason }}</p><p v-if="record.state==='starting'">启动请求已受理，真实执行标识尚待确认。</p><div class="commands"><el-button :disabled="!!busy" @click="readExecution">查询执行与证据</el-button><el-button v-if="record.state==='unknown'&&provider.readRecoveryPreflight" :disabled="!!busy" @click="readRecoveryPreflight">读取恢复条件（不处置）</el-button><el-button v-if="record.state==='unknown'&&provider.abandonBeforeTurn" :disabled="!!busy||isStale(record)||!recoveryPreview?.canRequestVerification||recoveryPreview.revision!==record.revision" @click="abandonBeforeTurn">核对未派发并放弃</el-button><span v-if="record.state==='unknown'">仅服务端证据全部核实后追加放弃；不重发任务，原 UNKNOWN 审计保留。</span><el-button v-if="['running','queued'].includes(displayedState(record))" :disabled="recordLocked||!run?.executionId" @click="pause">请求安全边界暂停</el-button><el-button v-if="record.state==='paused'" :disabled="locked||!readinessProofCurrent" @click="resume">核对状态并恢复</el-button></div><section v-if="record.state==='unknown'" aria-label="恢复证据预检"><p>先读取本地证据条件；缺证时不能放弃。预检不会加载线程或调用模型，也不证明当前可安全处置。</p><p v-if="recoveryPreviewError" role="alert">{{ recoveryPreviewError }}</p><template v-if="recoveryPreview"><p>本地记录观察：{{ recoveryPreview.observedAt }} · 目标 revision {{ recoveryPreview.revision }}</p><ul><li v-for="check in recoveryPreview.checks" :key="check.id"><strong>{{ check.status==='missing'?'缺少证据':check.status==='unverified'?'尚未核实':'历史记录' }}</strong>：{{ check.message }}</li></ul><p v-if="!recoveryPreview.canRequestVerification" role="status">当前缺少必要记录，处置按钮已禁用；原 UNKNOWN 保留。</p><p v-else role="status">本地必要记录齐备；请求完整核对仍由原服务端严格重查，当前未证明可放弃。</p></template></section><p v-if="['running','queued','pause-requested','paused'].includes(record.state)">暂停等待执行器的安全边界回执，不承诺立即取消。恢复先核对原执行标识。</p>
   <ul aria-label="日志引用"><li v-for="log in details?.logs??[]" :key="log.ref"><strong>{{ log.ref }}</strong><p>{{ log.summary??'仅有引用，正文尚未读取' }}</p><small>{{ log.digest }} {{ log.at }}</small></li></ul><ul v-if="!details?.logs?.length&&run?.logRefs.length"><li v-for="ref in run.logRefs" :key="ref">{{ ref }} · 日志引用，正文未读取</li></ul></section>
   <section v-if="showSection('execution')" aria-label="当前会话审批"><h4>当前会话审批</h4><p class="metadata">只处理原会话本次待决请求，不授予整段会话权限；任务写入范围由后端验证，本页没有整段会话或仓库权限开关。</p><el-button :disabled="!!busy||!provider.readApprovals" @click="readApprovals">读取当前会话审批</el-button><p v-if="!provider.readApprovals">审批适配器未接通，能力未验证。</p><p v-if="approvalError" role="status">{{ approvalError }}</p><p v-if="approvalsStale">上次审批观察 · 当前待核对，不能批准或重发。</p><p v-if="approvals===null">尚未读取真实待决请求；不能据此认定没有审批。</p><template v-else><p v-if="!approvals.enabled">审批能力未启用。不能据此认定没有待决请求。</p><p v-else-if="!approvals.approvals.length">本次读取未见待决请求。后续连接状态仍需重新核对。</p><p class="metadata">观察时间 {{ approvals.observedAt }}</p><article v-for="a in approvals.approvals" :key="a.id" class="approval-entry"><h5>{{ a.kind==='command'?'命令请求':'文件变更请求' }} · {{ approvalStateLabels[a.state] }}</h5><p>{{ a.summary }}</p><pre v-if="a.display.command">{{ a.display.command }}</pre><ul v-if="a.display.relativePaths?.length"><li v-for="path in a.display.relativePaths" :key="path">{{ path }}</li></ul><dl><dt>请求 / 版本</dt><dd>{{ a.id }} / {{ a.version }}</dd><dt>摘要</dt><dd>{{ a.approvalDigest }}</dd><dt>原始来源</dt><dd>{{ a.threadId }} / {{ a.turnId }} / {{ a.itemId }}</dd><dt>连接</dt><dd>{{ a.connectionId }} · {{ a.state==='disconnected'?'已断线':a.canRespond&&a.state==='pending'?'原连接报告可响应':'当前不可响应' }}</dd><dt>有效期</dt><dd>{{ a.expiresAt }}<strong v-if="Date.parse(a.expiresAt)<=approvalClock"> · 已过期，不能响应</strong></dd></dl><div class="commands"><el-button :disabled="!approvalActionable(a)||!provider.decideApproval" @click="decideApproval(a,'accept')">仅本次批准</el-button><el-button :disabled="!approvalActionable(a)||!provider.decideApproval" @click="decideApproval(a,'decline')">拒绝本次请求</el-button></div></article></template></section>
