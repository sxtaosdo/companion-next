+import { execFile } from "node:child_process";
+import { isAbsolute, resolve } from "node:path";
+import { isPidAlive } from "./platform.js";
+
+/** A failed ownership/exit check is not permission to retry with another PID. */
+export class CreatorStopFault extends Error {
+  readonly code = "CREATOR_STOP_UNCONFIRMED";
+  constructor(readonly stage = "unknown", readonly nativeCode?: number) { super(`Creator 所属进程退出未能确认（${stage}）；保留原进程身份，未自动重试`); }
+}
+
+export interface CreatorStopReceipt { pid: number; exitedPids: number[]; exitConfirmed: true }
+
+/** Stop one Windows Creator instance using fixed OS handles, never taskkill /T or a name-wide kill. */
+export async function stopCreatorProcess(pid: number, projectPath: string): Promise<CreatorStopReceipt> {
+  if (!Number.isSafeInteger(pid) || pid <= 0 || !isAbsolute(projectPath)) throw new CreatorStopFault();
+  if (process.platform !== "win32") {
+    try { process.kill(pid, "SIGTERM"); } catch (error) { if ((error as NodeJS.ErrnoException).code !== "ESRCH") throw new CreatorStopFault(); }
+    const deadline = Date.now() + 10_000;
+    while (isPidAlive(pid)) { if (Date.now() >= deadline) throw new CreatorStopFault(); await new Promise(resolve => setTimeout(resolve, 50)); }
+    return { pid, exitedPids: [pid], exitConfirmed: true };
+  }
+  const payload = Buffer.from(JSON.stringify({ pid, projectPath: resolve(projectPath) }), "utf8").toString("base64");
+  const script = WINDOWS_CREATOR_STOP.replace("__PAYLOAD__", payload);
+  const encoded = Buffer.from(script, "utf16le").toString("base64");
+  let output: string;
+  try {
+    output = await new Promise<string>((accept, reject) => execFile("powershell.exe", ["-NoProfile", "-NonInteractive", "-OutputFormat", "Text", "-EncodedCommand", encoded], {
+      windowsHide: true, timeout: 30_000, maxBuffer: 128 * 1024, encoding: "utf8",
+    }, (error, stdout) => {
+      if (!error) return accept(String(stdout).replace(/^\uFEFF/, "").trim());
+      try {
+        const failure = JSON.parse(String(stdout).replace(/^\uFEFF/, "").trim()) as { failureStage?: unknown; nativeCode?: unknown };
+        if (typeof failure.failureStage === "string" && /^(?:root-open|root-query|root-project|discover|root-terminate|descendant-terminate|wait-rescan|receipt)$/.test(failure.failureStage)) {
+          return reject(new CreatorStopFault(failure.failureStage, typeof failure.nativeCode === "number" && Number.isSafeInteger(failure.nativeCode) ? failure.nativeCode : undefined));
+        }
+      } catch { /* Raw stderr/commands never cross the platform boundary. */ }
+      reject(new CreatorStopFault());
+    }));
+    const value = JSON.parse(output) as CreatorStopReceipt;
+    if (value.pid !== pid || value.exitConfirmed !== true || !Array.isArray(value.exitedPids) || !value.exitedPids.includes(pid)
+      || value.exitedPids.some(id => !Number.isSafeInteger(id) || id <= 0)) throw new CreatorStopFault();
+    return value;
+  } catch (error) { throw error instanceof CreatorStopFault ? error : new CreatorStopFault(); }
+}
+
+/** Exported only for syntax/identity boundary regression; payload is base64 data, not shell code. */
+export const WINDOWS_CREATOR_STOP = String.raw`
+$ErrorActionPreference = 'Stop'
+$env:PSModulePath = $PSHOME + '\Modules'
+[Console]::OutputEncoding = New-Object System.Text.UTF8Encoding $false
+$inputData = [Text.Encoding]::UTF8.GetString([Convert]::FromBase64String('__PAYLOAD__')) | ConvertFrom-Json
+Add-Type -TypeDefinition @'
+using System;
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+using System.Text;
+public sealed class OwnedCreatorHandle : IDisposable {
+  [DllImport("kernel32.dll", SetLastError=true)] static extern IntPtr OpenProcess(uint access, bool inherit, int pid);
+  [DllImport("kernel32.dll", SetLastError=true)] static extern bool CloseHandle(IntPtr h);
+  [DllImport("kernel32.dll", SetLastError=true)] static extern bool GetProcessTimes(IntPtr h, out long c, out long e, out long k, out long u);
+  [DllImport("kernel32.dll", CharSet=CharSet.Unicode, SetLastError=true)] static extern bool QueryFullProcessImageName(IntPtr h, uint flags, StringBuilder text, ref int size);
+  [DllImport("kernel32.dll", SetLastError=true)] static extern bool TerminateProcess(IntPtr h, uint code);
+  [DllImport("kernel32.dll", SetLastError=true)] static extern uint WaitForSingleObject(IntPtr h, uint timeout);
+  [DllImport("shell32.dll", CharSet=CharSet.Unicode, SetLastError=true)] static extern IntPtr CommandLineToArgvW(string cmd, out int count);
+  [DllImport("kernel32.dll")] static extern IntPtr LocalFree(IntPtr h);
+  IntPtr handle;
+  bool terminationRequested;
+  public int Pid { get; private set; }
+  public string Image { get; private set; }
+  public DateTime Created { get; private set; }
+  public DateTime? Exited { get { long c,e,k,u; if(!GetProcessTimes(handle,out c,out e,out k,out u)) throw new Win32Exception(); return e==0 ? (DateTime?)null : DateTime.FromFileTimeUtc(e); } }
+  public bool Gone { get { uint s=WaitForSingleObject(handle,0); if(s==0) return true; if(s==258) return false; throw new Win32Exception(); } }
+  public static OwnedCreatorHandle Hold(int pid) {
+    IntPtr h=OpenProcess(0x00101001,false,pid);
+    if(h==IntPtr.Zero) { if(Marshal.GetLastWin32Error()==87) return null; throw new Win32Exception(); }
+    try { long c,e,k,u; if(!GetProcessTimes(h,out c,out e,out k,out u)) throw new Win32Exception();
+      var text=new StringBuilder(32768);int size=text.Capacity; if(!QueryFullProcessImageName(h,0,text,ref size)) throw new Win32Exception();
+      return new OwnedCreatorHandle {handle=h,Pid=pid,Image=text.ToString(),Created=DateTime.FromFileTimeUtc(c)};
+    } catch { bool gone=WaitForSingleObject(h,0)==0;CloseHandle(h);if(gone)return null;throw; }
+  }
+  public void Stop() { if(Gone || terminationRequested) return; if(!TerminateProcess(handle,0)) { int error=Marshal.GetLastWin32Error(); if(!Gone) throw new Win32Exception(error); } terminationRequested=true; }
+  public static string[] Arguments(string cmd) {
+    int count;IntPtr argv=CommandLineToArgvW(cmd,out count);if(argv==IntPtr.Zero) throw new Win32Exception();
+    try { var result=new string[count]; for(int i=0;i<count;i++) result[i]=Marshal.PtrToStringUni(Marshal.ReadIntPtr(argv,i*IntPtr.Size));return result; }
+    finally { LocalFree(argv); }
+  }
+  public void Dispose() { if(handle!=IntPtr.Zero) { CloseHandle(handle);handle=IntPtr.Zero; } }
+}
+'@
+function PathKey([string]$value) { return [IO.Path]::GetFullPath($value).TrimEnd('\','/').ToUpperInvariant() }
+function ProjectMatch([string]$command, [bool]$required) {
+  if ([string]::IsNullOrWhiteSpace($command)) { throw 'CREATOR_COMMAND_UNVERIFIED' }
+  $arguments = [OwnedCreatorHandle]::Arguments($command)
+  $found = 0
+  for ($i=1; $i -lt $arguments.Length; $i++) {
+    if ($arguments[$i] -in @('--path','--project')) {
+      if ($i+1 -ge $arguments.Length -or (PathKey $arguments[$i+1]) -ne $projectKey) { throw 'CREATOR_OTHER_PROJECT' }
+      $found++; $i++
+    } elseif ($arguments[$i] -match '^--(?:path|project)=') {
+      if ((PathKey ($arguments[$i] -replace '^--(?:path|project)=','')) -ne $projectKey) { throw 'CREATOR_OTHER_PROJECT' }
+      $found++
+    }
+  }
+  if ($required -and $found -ne 1) { throw 'CREATOR_PROJECT_UNVERIFIED' }
+  if ($required -and @($arguments | Where-Object { $_ -match '^--type(?:=|$)' }).Count) { throw 'CREATOR_ROOT_UNVERIFIED' }
+}
+$held = @{}
+$projectKey = PathKey ([string]$inputData.projectPath)
+$deadline = [DateTime]::UtcNow.AddSeconds(20)
+$phase = 'root-open'
+try {
+  $root = [OwnedCreatorHandle]::Hold([int]$inputData.pid)
+  if ($null -eq $root) { throw 'CREATOR_ROOT_ABSENT_UNVERIFIED' }
+  $held[$root.Pid] = $root
+  if ([IO.Path]::GetFileName($root.Image) -ine 'CocosCreator.exe') { throw 'CREATOR_EXE_UNVERIFIED' }
+  $imageKey = PathKey $root.Image
+  $phase = 'root-query'
+  $row = Get-CimInstance Win32_Process -Filter ('ProcessId=' + $root.Pid)
+  if ($null -eq $row -or (PathKey $row.ExecutablePath) -ne $imageKey -or [Math]::Abs(($row.CreationDate.ToUniversalTime()-$root.Created).TotalMilliseconds) -gt 1) { throw 'CREATOR_ROOT_IDENTITY_UNVERIFIED' }
+  $phase = 'root-project'
+  ProjectMatch ([string]$row.CommandLine) $true
+  function Discover {
+    $rows = @(Get-CimInstance Win32_Process -Filter "Name='CocosCreator.exe'")
+    $count = 0
+    do {
+      $added = 0
+      foreach ($candidate in $rows) {
+        $id = [int]$candidate.ProcessId
+        if ($held.ContainsKey($id) -or !$held.ContainsKey([int]$candidate.ParentProcessId)) { continue }
+        $parent = $held[[int]$candidate.ParentProcessId]
+        $created = $candidate.CreationDate.ToUniversalTime()
+        $exited = $parent.Exited
+        if ($created -lt $parent.Created -or ($null -ne $exited -and $created -gt $exited)) { continue }
+        $child = [OwnedCreatorHandle]::Hold($id)
+        if ($null -eq $child) { throw 'CREATOR_OBSERVED_CHILD_IDENTITY_LOST' }
+        try {
+          if ((PathKey $child.Image) -ne $imageKey -or (PathKey $candidate.ExecutablePath) -ne $imageKey -or [Math]::Abs(($created-$child.Created).TotalMilliseconds) -gt 1) { throw 'CREATOR_CHILD_IDENTITY_UNVERIFIED' }
+          ProjectMatch ([string]$candidate.CommandLine) $false
+          $held[$id] = $child; $child = $null; $added++; $count++
+        } finally { if ($null -ne $child) { $child.Dispose() } }
+      }
+    } while ($added -gt 0)
+    return $count
+  }
+  # Validate the initial tree before the first termination. Keep every OS handle
+  # until all bounded rescans finish, so an exited parent's PID cannot be reused.
+  $phase = 'discover'
+  $null = Discover
+  if ([DateTime]::UtcNow -gt $deadline) { throw 'CREATOR_TREE_EXIT_TIMEOUT' }
+  $phase = 'root-terminate'
+  $root.Stop()
+  $settled = 0
+  do {
+    $phase = 'descendant-terminate'
+    foreach ($entry in @($held.Values)) { $entry.Stop() }
+    $phase = 'wait-rescan'
+    $new = Discover
+    $active = @($held.Values | Where-Object { !$_.Gone })
+    if (!$active.Count -and !$new) { $settled++ } else { $settled=0 }
+    if ([DateTime]::UtcNow -gt $deadline) { throw 'CREATOR_TREE_EXIT_TIMEOUT' }
+    if ($settled -ge 2) { break }
+    Start-Sleep -Milliseconds 100
+  } while ($true)
+  $phase = 'receipt'
+  @{ pid=[int]$inputData.pid; exitedPids=@($held.Keys | Sort-Object); exitConfirmed=$true } | ConvertTo-Json -Compress
+} catch {
+  $native = 0
+  if ($_.Exception.InnerException -is [ComponentModel.Win32Exception]) { $native=$_.Exception.InnerException.NativeErrorCode }
+  @{ failureStage=$phase; nativeCode=$native } | ConvertTo-Json -Compress
+  throw 'CREATOR_STOP_UNCONFIRMED'
+} finally { foreach ($entry in @($held.Values)) { $entry.Dispose() } }
+`;
