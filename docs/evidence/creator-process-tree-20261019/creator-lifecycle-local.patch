+    await expect(lifecycle.start(project)).rejects.toMatchObject({ code: "CREATOR_STOP_UNCONFIRMED" });
+    expect(boundary.launch).toHaveBeenCalledTimes(1);
+  });
+  it("has a distinct missing-PID recovery signal and requires a registered path", async () => {
+    const stop = vi.fn(async () => {}), lifecycle = new CreatorLifecycle(adapter(stop));
+    await expect(lifecycle.stop(project.id)).rejects.toMatchObject({ code: "CREATOR_PID_UNAVAILABLE" });
+    await expect(lifecycle.stop(project.id, { pid: 101 })).rejects.toMatchObject({ code: "CREATOR_STOP_UNCONFIRMED" });
+    expect(stop).not.toHaveBeenCalled();
+    await lifecycle.stop(project.id, { pid: 101, projectPath: project.path });
+    expect(stop).toHaveBeenCalledExactlyOnceWith(101, project.path);
