+import { execFileSync } from "node:child_process";
+import { describe, expect, it, vi } from "vitest";
+import { CreatorLifecycle, type CreatorLifecycleAdapter } from "../src/companion/creator-lifecycle.js";
+import { CreatorStopFault, WINDOWS_CREATOR_STOP } from "../src/companion/creator-process-stop.js";
+
+const project = { id: "p1", name: "owned", path: "C:/owned/game", connectionPath: "C:/owned/game/temp/connection.json" };
+function adapter(stop: NonNullable<CreatorLifecycleAdapter["stop"]>): CreatorLifecycleAdapter {
+  let pid = 100;
+  return { launch: vi.fn(async () => ({ pid: ++pid, reused: false })), focus: async () => {}, isPidAlive: () => true,
+    waitForBridge: async () => ({ creatorVersion: "3.8.8", sessionId: `s${pid}` }), hasUnsavedChanges: async () => false,
+    waitForStopped: async () => {}, stop };
+}
+describe("owned Creator stop completion", () => {
+  it("rejects stop while a Bridge wait can still complete the original start", async () => {
+    let release!: () => void; const boundary = adapter(vi.fn(async () => {}));
+    boundary.waitForBridge = () => new Promise(resolve => { release = () => resolve({ creatorVersion: "3.8.8", sessionId: "start-only" }); });
+    const lifecycle = new CreatorLifecycle(boundary), start = lifecycle.start(project);
+    await Promise.resolve();
+    await expect(lifecycle.stop(project.id)).rejects.toThrow("busy: starting");
+    expect(boundary.stop).not.toHaveBeenCalled();
+    release(); await expect(start).resolves.toMatchObject({ state: "ready", sessionId: "start-only" });
+  });
+  it("rejects start during the unsaved-document check before stopping state is published", async () => {
+    let release!: () => void; const boundary = adapter(async () => {}), lifecycle = new CreatorLifecycle(boundary);
+    await lifecycle.start(project);
+    boundary.hasUnsavedChanges = () => new Promise(resolve => { release = () => resolve(false); });
+    const stop = lifecycle.stop(project.id);
+    expect(lifecycle.status(project.id).state).toBe("ready");
+    await expect(lifecycle.start(project)).rejects.toThrow("busy: stopping");
+    release(); await expect(stop).resolves.toMatchObject({ state: "stopped" });
+  });
+  it("waits for exit proof and coalesces a second stop, not merely a kill acknowledgement", async () => {
+    let release!: () => void; const stop = vi.fn(() => new Promise<void>(resolve => { release = resolve; }));
+    const lifecycle = new CreatorLifecycle(adapter(stop)); await lifecycle.start(project);
+    const first = lifecycle.stop(project.id), second = lifecycle.stop(project.id);
+    await Promise.resolve(); expect(first).toBe(second); expect(lifecycle.status(project.id)).toMatchObject({ state: "stopping", pid: 101 });
+    await expect(lifecycle.start(project)).rejects.toThrow("busy");
+    release(); await expect(first).resolves.toMatchObject({ state: "stopped" });
+    expect(stop).toHaveBeenCalledExactlyOnceWith(101, project.path);
+  });
