diff --git a/mcp/src/companion/knowledge-isolation.ts b/mcp/src/companion/knowledge-isolation.ts
new file mode 100644
index 0000000..96a6987
--- /dev/null
+++ b/mcp/src/companion/knowledge-isolation.ts
@@ -0,0 +1,137 @@
+import { spawn } from "node:child_process";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { KnowledgeAdapter, KnowledgeFault, type KnowledgeBackend, type KnowledgePayload, type KnowledgeStatus } from "./knowledge-adapter.js";
+
+export const READER_KB = "da1051a5-3fff-4198-ba55-017ea79df9c3";
+export const READER_METHODS = ["search", "listKnowledgeBases", "viewKnowledgeBase", "listDocuments", "viewDocument", "listChunks", "downloadDocument"] as const;
+export type ReaderMethod = typeof READER_METHODS[number];
+let workers = 0;
+let unknownWorkers = 0;
+/** An unacknowledged worker exit remains unknown until this daemon is restarted. */
+export function knowledgeWorkerInFlightCount(): number { return workers; }
+export function knowledgeWorkerUnknownCount(): number { return unknownWorkers; }
+
+export function assertNoSharedKnowledgeCredentials(env: NodeJS.ProcessEnv): void {
+  if (Object.keys(env).some((name) => ["WEKNORA_API_KEY", "KNOWLEDGE_SYNC_API_KEY"].includes(name.toUpperCase()))) {
+    throw new Error("KNOWLEDGE_SHARED_CREDENTIAL_ENV_REJECTED");
+  }
+}
+
+export function knowledgeWorkerEnv(env: NodeJS.ProcessEnv): NodeJS.ProcessEnv {
+  const result: NodeJS.ProcessEnv = { NO_PROXY: "127.0.0.1,localhost", no_proxy: "127.0.0.1,localhost" };
+  for (const name of ["SystemRoot", "SYSTEMROOT", "WINDIR", "TEMP", "TMP"]) if (env[name]) result[name] = env[name];
+  return result;
+}
+
+export interface IsolatedKnowledgeOptions {
+  credentialFile?: string;
+  workerPath?: string;
+  workerArgs?: string[];
+  base?: KnowledgeBackend;
+}
+
+/** The shared process never loads a reader key. Only this private pipe carries requests. */
+export class IsolatedKnowledgeAdapter extends KnowledgeAdapter {
+  private readonly base: KnowledgeBackend;
+  private readerAuth: KnowledgeStatus["retrieval"]["auth"];
+  private readerKeyword: KnowledgeStatus["retrieval"]["keyword"] = "unverified";
+  private running = false;
+  constructor(private readonly isolation: IsolatedKnowledgeOptions = {}) {
+    super();
+    this.base = isolation.base ?? new KnowledgeAdapter();
+    this.readerAuth = isolation.credentialFile ? "configured" : "missing";
+  }
+  override async status(signal?: AbortSignal): Promise<KnowledgeStatus> {
+    const status = await this.base.status(signal);
+    return { ...status, retrieval: { ...status.retrieval, auth: this.readerAuth, keyword: this.readerKeyword } };
+  }
+  override async sync(input: unknown, write: boolean, signal?: AbortSignal) { return this.base.sync(input, write, signal); }
+  override async search(input: unknown, signal?: AbortSignal): ReturnType<KnowledgeBackend["search"]> {
+    const value = await this.read("search", input, signal);
+    this.readerKeyword = "verified";
+    return value as Awaited<ReturnType<KnowledgeBackend["search"]>>;
+  }
+  override listKnowledgeBases(input: unknown, signal?: AbortSignal) { return this.read("listKnowledgeBases", input, signal); }
+  override viewKnowledgeBase(input: unknown, signal?: AbortSignal) { return this.read("viewKnowledgeBase", input, signal); }
+  override listDocuments(input: unknown, signal?: AbortSignal) { return this.read("listDocuments", input, signal); }
+  override viewDocument(input: unknown, signal?: AbortSignal) { return this.read("viewDocument", input, signal); }
+  override listChunks(input: unknown, signal?: AbortSignal) { return this.read("listChunks", input, signal); }
+  override downloadDocument(input: unknown, signal?: AbortSignal) { return this.read("downloadDocument", input, signal); }
+  // Existing retrieve-only identity does not authorize inference or agents.
+  override async chat(_input?: unknown, _signal?: AbortSignal): Promise<KnowledgePayload> { throw new KnowledgeFault("CHAT_UNAVAILABLE", 403); }
+  override async listAgents(_input?: unknown, _signal?: AbortSignal): Promise<KnowledgePayload> { throw new KnowledgeFault("AUTH_DENIED", 403); }
+  override async askAgent(_input?: unknown, _signal?: AbortSignal): Promise<KnowledgePayload> { throw new KnowledgeFault("CHAT_UNAVAILABLE", 403); }
+
+  private async read(method: ReaderMethod, input: unknown, signal?: AbortSignal): Promise<KnowledgePayload> {
+    if (!this.isolation.credentialFile) throw new KnowledgeFault("AUTH_MISSING", 401);
+    if (signal?.aborted) throw new KnowledgeFault("CANCELLED", 499);
+    if (this.running || unknownWorkers > 0) throw new KnowledgeFault("BUSY", 429);
+    this.running = true;
+    try {
+      const result = await this.request(method, input, signal);
+      this.readerAuth = "verified";
+      return result;
+    } catch (error) {
+      if (error instanceof KnowledgeFault && error.code === "AUTH_DENIED") { this.readerAuth = "denied"; this.readerKeyword = "unverified"; }
+      throw error;
+    } finally { this.running = false; }
+  }
+
+  private request(method: ReaderMethod, input: unknown, signal?: AbortSignal): Promise<KnowledgePayload> {
+    return new Promise((resolve, reject) => {
+      const path = this.isolation.workerPath ?? join(dirname(fileURLToPath(import.meta.url)), "knowledge-worker.js");
+      const child = spawn(process.execPath, [...(this.isolation.workerArgs ?? []), path], {
+        env: knowledgeWorkerEnv(process.env), shell: false, windowsHide: true, stdio: ["pipe", "pipe", "pipe"],
+      });
+      workers++;
+      let bytes = 0; let stdoutBytes = 0;
+      let fault: KnowledgeFault | undefined;
+      const chunks: Buffer[] = [];
+      let cancelSent = false;
+      const cancel = () => {
+        fault ??= new KnowledgeFault("CANCELLED", 499);
+        if (!cancelSent) { cancelSent = true; child.stdin.write('{"cancel":true}\n'); }
+      };
+      const timeout = setTimeout(() => { fault ??= new KnowledgeFault("TIMEOUT", 504); cancel(); }, 50_000);
+      let markedUnknown = false;
+      // Never kill the worker while it may own a credential-bearing child. Keep ownership
+      // and block drain if cooperative cancellation cannot establish child exit.
+      const hardTimeout = setTimeout(() => {
+        markedUnknown = true; unknownWorkers++;
+        fault ??= new KnowledgeFault("TIMEOUT", 504);
+        reject(fault);
+      }, 60_000);
+      const count = (chunk: Buffer, keep: boolean) => {
+        bytes += chunk.length;
+        if (bytes > 2 * 1024 * 1024) { fault ??= new KnowledgeFault("OUTPUT_LIMIT"); cancel(); }
+        // Preserve a bounded control acknowledgement after discarded stderr overflow.
+        if (keep) { stdoutBytes += chunk.length; if (stdoutBytes <= 2 * 1024 * 1024) chunks.push(chunk); }
+      };
+      child.stdout.on("data", (chunk: Buffer) => count(chunk, true));
+      child.stderr.on("data", (chunk: Buffer) => count(chunk, false));
+      child.stdin.on("error", () => {});
+      child.on("error", () => { fault ??= new KnowledgeFault("CLI_UNAVAILABLE", 503); });
+      child.once("close", (code) => {
+        clearTimeout(timeout); clearTimeout(hardTimeout); signal?.removeEventListener("abort", cancel);
+        let acknowledged = false;
+        try {
+          const response = JSON.parse(Buffer.concat(chunks).toString("utf8"));
+          if (code !== 0 || response?.settled !== true || typeof response.ok !== "boolean") throw new KnowledgeFault("UPSTREAM_UNAVAILABLE", 503);
+          acknowledged = true;
+          if (markedUnknown) unknownWorkers--;
+          workers--;
+          if (fault) throw fault;
+          if (!response.ok) throw new KnowledgeFault(response.code, response.status);
+          resolve(response.value as KnowledgePayload);
+        } catch (error) {
+          if (!acknowledged && !markedUnknown) unknownWorkers++;
+          reject(error instanceof KnowledgeFault ? error : new KnowledgeFault("UPSTREAM_UNAVAILABLE", 503));
+        }
+      });
+      signal?.addEventListener("abort", cancel, { once: true });
+      child.stdin.write(JSON.stringify({ method, input, credentialFile: this.isolation.credentialFile }) + "\n");
+      if (signal?.aborted) cancel();
+    });
+  }
+}
diff --git a/mcp/src/companion/knowledge-worker-core.ts b/mcp/src/companion/knowledge-worker-core.ts
new file mode 100644
index 0000000..d642de9
--- /dev/null
+++ b/mcp/src/companion/knowledge-worker-core.ts
@@ -0,0 +1,116 @@
+import { createInterface } from "node:readline";
+import { open, lstat } from "node:fs/promises";
+import { join } from "node:path";
+import { KnowledgeAdapter, KnowledgeFault, jsonProcessInFlightCount, runJsonProcess, type KnowledgeBackend } from "./knowledge-adapter.js";
+import { knowledgeWorkerEnv, READER_KB, READER_METHODS, type ReaderMethod } from "./knowledge-isolation.js";
+
+export function validReaderIdentity(payload: unknown, now = Date.now()): boolean {
+  const value = payload as { success?: unknown; data?: Record<string, unknown> } | null;
+  const d = value?.data;
+  return value?.success === true && !!d && d.key_id === 3 && d.tenant_id === 1 && d.scope_type === "tenant" &&
+    d.full_access === false && JSON.stringify(d.knowledge_base_ids) === JSON.stringify([READER_KB]) &&
+    JSON.stringify(d.capabilities) === '["retrieve"]' && typeof d.expires_at === "string" &&
+    Date.parse(d.expires_at) > now && Date.parse(d.expires_at) === Date.parse("2026-11-08T01:25:46Z");
+}
+
+export async function verifyReader(key: string, signal: AbortSignal, endpoint = "http://127.0.0.1:8081"): Promise<void> {
+  const response = await fetch(endpoint + "/api/v1/auth/reader-identity", {
+    headers: { "X-API-Key": key, Accept: "application/json" }, redirect: "error",
+    signal: AbortSignal.any([signal, AbortSignal.timeout(10_000)]),
+  });
+  if (!response.ok || !response.body) throw new KnowledgeFault("AUTH_DENIED", 403);
+  const chunks: Uint8Array[] = []; let bytes = 0;
+  for await (const chunk of response.body) {
+    bytes += chunk.length;
+    if (bytes > 16_384) throw new KnowledgeFault("AUTH_DENIED", 403);
+    chunks.push(chunk);
+  }
+  if (!validReaderIdentity(JSON.parse(Buffer.concat(chunks).toString("utf8")))) throw new KnowledgeFault("AUTH_DENIED", 403);
+}
+
+/** Reads only the opt-in encrypted blob; plaintext exists only in worker/owned decryptor memory and their pipe. */
+export async function loadDpapiCredential(path: string, signal: AbortSignal): Promise<string> {
+  if (process.platform !== "win32") throw new KnowledgeFault("AUTH_MISSING", 401);
+  const before = await lstat(path);
+  if (!before.isFile() || before.isSymbolicLink() || before.size < 1 || before.size > 32_768) throw new KnowledgeFault("AUTH_MISSING", 401);
+  const file = await open(path, "r");
+  let encrypted: string;
+  try {
+    const current = await file.stat();
+    if (!current.isFile() || current.size !== before.size || current.ino !== before.ino || current.dev !== before.dev) throw new KnowledgeFault("AUTH_MISSING", 401);
+    const buffer = Buffer.alloc(32_769);
+    const { bytesRead } = await file.read(buffer, 0, buffer.length, 0);
+    if (bytesRead !== current.size || bytesRead > 32_768) throw new KnowledgeFault("AUTH_MISSING", 401);
+    encrypted = buffer.subarray(0, bytesRead).toString("utf8").replace(/^\uFEFF/, "").trim();
+    if (!/^[0-9a-f]+$/i.test(encrypted)) throw new KnowledgeFault("AUTH_MISSING", 401);
+  } finally { await file.close(); }
+  const script = "$ErrorActionPreference='Stop'; $s=[Console]::In.ReadToEnd()|ConvertTo-SecureString; $p=[IntPtr]::Zero; try {$p=[Runtime.InteropServices.Marshal]::SecureStringToBSTR($s); @{key=[Runtime.InteropServices.Marshal]::PtrToStringBSTR($p)}|ConvertTo-Json -Compress} finally {if($p -ne [IntPtr]::Zero){[Runtime.InteropServices.Marshal]::ZeroFreeBSTR($p)}; $s.Dispose()}";
+  const value = await runJsonProcess({
+    executable: join(process.env.SystemRoot ?? "C:/Windows", "System32/WindowsPowerShell/v1.0/powershell.exe"),
+    args: ["-NoProfile", "-NonInteractive", "-Command", script], env: knowledgeWorkerEnv(process.env),
+    input: encrypted, maxBytes: 16_384, timeoutMs: 10_000, waitForClose: true,
+  }, signal) as { key?: unknown };
+  if (typeof value.key !== "string" || !value.key || value.key.length > 8192 || /[\r\n\0]/.test(value.key)) throw new KnowledgeFault("AUTH_DENIED", 403);
+  return value.key;
+}
+
+export function redactReaderOutput(value: unknown, key: string): unknown {
+  if (typeof value === "string") {
+    return [key, JSON.stringify(key).slice(1, -1), Buffer.from(key).toString("base64"), encodeURIComponent(key)].reduce((text, secret) => text.split(secret).join("[redacted]"), value);
+  }
+  if (value && typeof value === "object" && "isBase64" in value && value.isBase64 === true && "content" in value && typeof value.content === "string") {
+    const bytes = Buffer.from(value.content, "base64");
+    if (bytes.includes(Buffer.from(key))) throw new KnowledgeFault("SCHEMA_INVALID");
+  }
+  if (Array.isArray(value)) return value.map((item) => redactReaderOutput(item, key));
+  if (value && typeof value === "object") return Object.fromEntries(Object.entries(value).map(([name, item]) => [String(redactReaderOutput(name, key)), redactReaderOutput(item, key)]));
+  return value;
+}
+
+export interface ReaderWorkerDependencies {
+  load: (path: string, signal: AbortSignal) => Promise<string>;
+  verify: (key: string, signal: AbortSignal) => Promise<void>;
+  backend: (key: string) => KnowledgeBackend;
+}
+
+/** One request, no listener or environment-carried secret; cancellation waits for owned CLI close. */
+export async function serveReaderWorker(deps: ReaderWorkerDependencies): Promise<void> {
+  const abort = new AbortController();
+  const lines = createInterface({ input: process.stdin, crlfDelay: Infinity });
+  let started = false; let size = 0;
+  let work: Promise<void> | undefined;
+  process.stdin.on("data", (chunk: Buffer) => { size += chunk.length; if (size > 16_384) abort.abort(); });
+  lines.on("close", () => abort.abort());
+  lines.on("line", (line) => {
+    if (started) { abort.abort(); return; }
+    started = true;
+    work = (async () => {
+      let reply: unknown;
+      try {
+        const request = JSON.parse(line) as { method?: unknown; input?: unknown; credentialFile?: unknown };
+        if (size > 16_384 || !READER_METHODS.includes(request.method as ReaderMethod) || typeof request.credentialFile !== "string") throw new KnowledgeFault("SCHEMA_INVALID", 400);
+        if (request.input && typeof request.input === "object" && "kbId" in request.input && request.input.kbId !== READER_KB) throw new KnowledgeFault("AUTH_DENIED", 403);
+        const key = await deps.load(request.credentialFile, abort.signal);
+        await deps.verify(key, abort.signal);
+        const backend = deps.backend(key);
+        const value = await backend[request.method as ReaderMethod](request.input, abort.signal);
+        reply = { settled: true, ok: true, value: redactReaderOutput(value, key) };
+      } catch (error) {
+        const fault = abort.signal.aborted ? new KnowledgeFault("CANCELLED", 499) : error instanceof KnowledgeFault ? error : new KnowledgeFault("AUTH_DENIED", 403);
+        reply = { settled: true, ok: false, code: fault.code, status: fault.httpStatus };
+      }
+      // Close-aware runner makes zero a real child-close observation, not kill-request evidence.
+      if (jsonProcessInFlightCount() !== 0) { process.exitCode = 1; return; }
+      process.stdout.write(JSON.stringify(reply));
+      lines.close(); process.stdin.destroy();
+    })();
+  });
+  await new Promise<void>((resolve) => { process.stdin.once("close", resolve); });
+  await work;
+}
+
+export const productionReaderWorker: ReaderWorkerDependencies = {
+  load: loadDpapiCredential, verify: verifyReader,
+  backend: (key) => new KnowledgeAdapter({ apiKey: key, keywordOnly: true,
+    runJson: (input, signal) => runJsonProcess({ ...input, waitForClose: true }, signal) }),
+};
